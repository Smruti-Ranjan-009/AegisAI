# Service ports
INCIDENT_SERVICE_PORT=8080
TELEMETRY_SERVICE_PORT=8001
ML_SERVICE_PORT=8002
RAG_SERVICE_PORT=8003

# Phase 3 local PostgreSQL defaults. Development only; replace outside local use.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegisai
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password

# Reserved for future Redis integration
REDIS_HOST=localhost
REDIS_PORT=6379

# Phase 2 local Kafka defaults (Docker services override localhost with kafka:19092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=telemetry.raw
KAFKA_PROCESSED_TOPIC=telemetry.processed
KAFKA_DLQ_TOPIC=telemetry.dlq
KAFKA_CONSUMER_GROUP=aegis-telemetry-processor-v1
KAFKA_PROCESSING_MAX_ATTEMPTS=3
KAFKA_RETRY_INITIAL_SECONDS=0.5

# Optional Phase 7 MLflow overrides. Blank values use repo-local defaults.
MLFLOW_TRACKING_URI=
MLFLOW_ARTIFACT_ROOT=

# Phase 8 knowledge ingestion. Generated output and model cache stay under .runtime/.
AEGIS_RAG_DATABASE_URL=postgresql://aegis:aegis_dev_password@localhost:5432/aegisai
AEGIS_RAG_CORPUS_ROOT=
AEGIS_RAG_RUNTIME_ROOT=
AEGIS_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AEGIS_RAG_EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
AEGIS_RAG_EMBEDDING_DIMENSION=384
AEGIS_RAG_EMBEDDING_DEVICE=cpu
AEGIS_RAG_EMBEDDING_BATCH_SIZE=32
AEGIS_RAG_TARGET_TOKENS=400
AEGIS_RAG_OVERLAP_TOKENS=60
AEGIS_RAG_MINIMUM_CHUNK_TOKENS=8
AEGIS_RAG_RETRIEVAL_RUNTIME_ROOT=
AEGIS_RAG_CANDIDATE_K=20
AEGIS_RAG_RRF_K=60

# Phase 10 reranking. The frozen baseline uses CPU, ten candidates, five evidence items.
AEGIS_RAG_RERANKING_RUNTIME_ROOT=
AEGIS_RAG_MODEL_CACHE=
AEGIS_RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
AEGIS_RAG_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
AEGIS_RAG_RERANKER_DEVICE=cpu
AEGIS_RAG_RERANKER_BATCH_SIZE=16
AEGIS_RAG_RERANK_CANDIDATE_K=10
AEGIS_RAG_GENERATION_EVIDENCE_K=5

# Phase 10 local llama.cpp/Qwen generation. Never expose this endpoint publicly.
AEGIS_RAG_SLM_ENDPOINT=http://127.0.0.1:8081
AEGIS_RAG_SLM_MODEL_PATH=
AEGIS_RAG_SLM_CONTEXT_TOKENS=4096
AEGIS_RAG_SLM_MAX_OUTPUT_TOKENS=768
AEGIS_RAG_SLM_TIMEOUT_SECONDS=300
